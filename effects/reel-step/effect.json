  "zone": "stage",
  "params": {
    "CHIP": {"default": "", "description": "The pill title at the top of the stage, e.g. \"STEP 1\""},
    "CHIP_SMALL": {"default": "", "description": "Smaller text after it, e.g. \"· Kapso\""},
    "APP": {"required": true, "description": "App name on the card"},
    "LOGO": {"type": "file", "default": "", "description": "Its real logo (optional)"},
    "BUTTON": {"default": "Sign up &#x2192;", "description": "The button the cursor presses"},
    "FIELD_LABEL": {"default": "", "description": "Label over the field"},
    "FIELD_TEXT": {"required": true, "description": "What types into the field (mask private numbers)"},
    "DONE": {"default": "&#x2713; Done", "description": "The green line at the end"},
    "BG": {"default": "bg", "choices": ["bg", "none"], "description": "\"bg\" draws the navy stage panel over the top half; \"none\" leaves it clear"}
